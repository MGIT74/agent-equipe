# ── Copiez ce fichier en .env et remplissez ──

# Mot de passe du WebUI Hermes (OBLIGATOIRE)
# Récupérable via : docker inspect hermes-webui | grep -A 5 HERMES_WEBUI_PASSWORD
HERMES_WEBUI_PASSWORD=

# Mot de passe admin initial de l'Agent Équipe (si team_users.json absent)
TEAM_ADMIN_PASSWORD=

# Optionnel : adresse du WebUI Hermes si différente
# TEAM_UPSTREAM_HOST=host.docker.internal
# TEAM_UPSTREAM_PORT=8787